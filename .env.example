# home_assist — copy to .env and fill in. .env is gitignored; this file is not.
#
# The minimum to boot: HOMEASSIST_ADMIN_* and the MYSQL_* block.
# Everything else has a working default. See README.md § Setup for the full reference.
#
# NOTE: values here are only DEFAULTS. Once the app has run, the water_settings table wins,
# and those are edited on the Settings page without a redeploy.

# ─────────────────────────── WEB SERVER ───────────────────────────
HOMEASSIST_PORT=8050
# Override where the built SPA is served from (default: src/home_assist/web/dist)
# HOMEASSIST_WEB_DIST=

# ─────────────────────────── AUTH (required) ──────────────────────
# Recovery admin — ALWAYS valid, never removable, so you can't lock yourself out of
# your own house dashboard. BOTH must be set for the account to count.
HOMEASSIST_ADMIN_USER=skip
HOMEASSIST_ADMIN_PASS=change-me

# Optional second admin (both required)
# HOMEASSIST_TEST_USER=
# HOMEASSIST_TEST_PASS=

# Cookie-signing key. If unset, one is generated into auth.json on first run.
# Set it explicitly if you want to be able to rotate it.
# HOMEASSIST_SESSION_SECRET=

# Where auth.json / panel_access.json / captures live. Default is per-platform —
# `node src/home_assist/admin.js where` prints the resolved paths.
# HOMEASSIST_DATA_DIR=
# Point at individual files instead (mainly for tests):
# HOMEASSIST_USERS_FILE=
# HOMEASSIST_PANEL_ACCESS_FILE=

# ─────────────────────────── MYSQL (required) ─────────────────────
# `npm run db_init` creates the database and tables.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=home_assist
MYSQL_CONNECTION_LIMIT=8

# ─────────────────────────── EMAIL ALERTS ─────────────────────────
# The primary alert channel. Same setup as wrestling_stats: Gmail SMTP + an APP
# password generated under 2-factor auth — your normal account password will NOT work.
#   Google Account -> Security -> 2-Step Verification -> App passwords -> Mail
#
# Leave blank and everything still runs: leaks are recorded, nobody is told.
# `node collector_water.js --check` reports the state.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# Only if you are not using Gmail. EMAIL_SECURE=true for port 465.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# ─────────────────────────── WATER MODULE ─────────────────────────
# Badger Orion classic pit transmitter, FCC ID GIF2006B.
# The radio id is NOT the serial printed on the endpoint (~857xxxxx) — see
# src/home_assist/plans_and_notes/water/HARDWARE.md.
WATER_METER_ID=16642655
WATER_GALLONS_PER_UNIT=1

# Local time for every hour bucket and the overnight window. Deliberately NOT the
# process timezone, so moving between machines can't silently shift the window.
WATER_TZ=America/Denver

# rtl_433 decoder. Protocol 223 = "Badger ORION water meter, 100kbps", fixed 916.45 MHz
# (the classic Orion does NOT frequency-hop; 282/290 are for newer hopping endpoints).
#
# Platform-suffixed, the same convention as wrestling_stats' .env
# (GOOGLE_APPLICATION_CREDENTIALS_LINUX / _MAC / _WINDOWS). ONE .env works on every machine —
# nothing to comment out when you move between the laptop and the Ubuntu box.
#
# Windows: point at the STATIC exe by full path. The nightly folder also holds rtl_433.exe,
#          the dynamic build, which loads librtlsdr.dll from beside it — and if that DLL has
#          been patched the two are not interchangeable. Do NOT keep it in OneDrive:
#          Files On-Demand can dehydrate the .exe and the collector then fails intermittently.
# Linux:   `make install` puts it on PATH at /usr/local/bin/rtl_433, so the bare name is enough.
WATER_RTL433_CMD_WINDOWS=C:/Users/calla/development/tools/noolec_v4_radio/rtl_433-win-x64-nightly/rtl_433_64bit_static.exe
WATER_RTL433_CMD_LINUX=rtl_433
# WATER_RTL433_CMD_MAC=/opt/homebrew/bin/rtl_433
#
# Set the unsuffixed name to override every platform. An EMPTY value counts as unset, so a
# leftover `WATER_RTL433_CMD=` cannot silently defeat the platform lines above.
# WATER_RTL433_CMD=
#
# `node collector_water.js --check` verifies whichever one applies resolves, reports WHICH key
# it came from, and confirms the build includes protocol 223.

WATER_RTL433_ARGS=-f 916.45M -s 1600k -R 223 -F json

# live   = spawn rtl_433 and read the real meter
# replay = synthetic meter or a captured file, through the same ingest path.
#          Lets you build and demo the UI with no dongle attached.
#          `--replay` on the command line does the same thing.
WATER_COLLECTOR_MODE=live
# WATER_REPLAY_FILE=

# ─────────────────────────── PUSH (optional) ──────────────────────
# Email is the primary channel. ntfy is a free phone-push service, off by default —
# useful because a 3am leak alert should wake you. The topic name is the only secret,
# so make it random. Also flip alert_ntfy_enabled to 1 on the Settings page.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
