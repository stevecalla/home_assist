{
  "name": "home_assist",
  "version": "0.1.0",
  "private": true,
  "description": "Home assistant platform shell (Express + React) \u2014 first module: Badger Orion water-meter leak monitor.",
  "main": "server_home_assist_8050.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "home_assist_menu": "node src/home_assist/menu.js",
    "menu": "node src/home_assist/menu.js",
    "home_assist_server": "node server_home_assist_8050.js",
    "home_assist_dev": "nodemon --watch server_home_assist_8050.js --watch src/home_assist --ext js server_home_assist_8050.js",
    "home_assist_web": "cd src/home_assist/web && npm run dev",
    "home_assist_dev_all": "concurrently -k -n api,web -c blue,green \"npm run home_assist_dev\" \"npm run home_assist_web\"",
    "home_assist_build": "cd src/home_assist/web && npm install && npm run build",
    "home_assist_test": "node src/home_assist/run_tests.js",
    "home_assist_check": "node src/home_assist/run_checks.js",
    "water_collector": "node collector_water.js",
    "water_collector_dev": "nodemon --watch collector_water.js --watch src/home_assist/modules/water --ext js collector_water.js",
    "water_check": "node collector_water.js --check",
    "water_replay": "node collector_water.js --replay",
    "water_replay_leak": "node collector_water.js --replay --leak",
    "water_capture": "node src/home_assist/modules/water/capture.js",
    "db_init": "node src/home_assist/store/init_db.js",
    "water_status": "node src/home_assist/modules/water/report.js status",
    "water_dbsize": "node src/home_assist/modules/water/report.js dbsize",
    "water_reset": "node src/home_assist/modules/water/report.js reset",
    "water_reset_confirm": "pm2 stop water_collector && node src/home_assist/modules/water/report.js reset --yes && pm2 flush water_collector && pm2 restart water_collector",
    "pm2_start_home_assist": "pm2 start server_home_assist_8050.js --name home_assist --time --exp-backoff-restart-delay=1000 --max-memory-restart 512M",
    "pm2_restart_home_assist": "pm2 restart home_assist",
    "pm2_stop_home_assist": "pm2 stop home_assist",
    "pm2_delete_home_assist": "pm2 delete home_assist",
    "pm2_show_home_assist": "pm2 show home_assist",
    "pm2_logs_home_assist": "pm2 logs home_assist --lines 200",
    "pm2_start_water_collector": "pm2 start collector_water.js --name water_collector --time --exp-backoff-restart-delay=1000 --max-memory-restart 512M",
    "pm2_restart_water_collector": "pm2 restart water_collector",
    "pm2_stop_water_collector": "pm2 stop water_collector",
    "pm2_delete_water_collector": "pm2 delete water_collector",
    "pm2_show_water_collector": "pm2 show water_collector",
    "pm2_logs_water_collector": "pm2 logs water_collector --lines 200",
    "pm2_start_all": "echo '(1 of 3) web server' && npm run pm2_start_home_assist && echo '(2 of 3) water collector' && npm run pm2_start_water_collector && echo '(3 of 3) saving process list' && npm run pm2_save",
    "pm2_restart_all": "pm2 restart home_assist water_collector",
    "pm2_stop_all": "pm2 stop home_assist water_collector",
    "pm2_delete_all": "pm2 delete home_assist water_collector",
    "pm2_list": "pm2 list",
    "pm2_status": "pm2 status",
    "pm2_monitor": "pm2 monit",
    "pm2_logs_all": "pm2 logs all --lines 200",
    "pm2_save": "pm2 save",
    "pm2_startup": "pm2 startup",
    "pm2_update": "pm2 update",
    "deploy": "npm run home_assist_build && (npm run pm2_restart_home_assist || npm run pm2_start_home_assist) && (npm run pm2_restart_water_collector || npm run pm2_start_water_collector) && npm run pm2_save"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7"
  },
  "keywords": [
    "home-assistant",
    "rtl_433",
    "water-meter",
    "leak-detection"
  ],
  "license": "MIT"
}
